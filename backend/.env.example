# NutriScan — variáveis do backend
# Copie para backend/.env e preencha (o .env é gitignored, NUNCA vai pro git).
# Ordem de prioridade: ambiente do shell/Render > este arquivo.

# ─── X-Api-Key: chave que o APP RN manda em toda chamada ───────────────────
# Mesmo valor aqui E no config do app (frontend). Impede consumo casual da API.
# Gerar:  python -c "import secrets; print(secrets.token_urlsafe(32))"
NUTRISCAN_API_KEY=

# ─── X-Admin-Token: da EQUIPE — cadastrar/apagar produto ───────────────────
# Usado em curl/Postman com header X-Admin-Token. NUNCA vai para o app.
# Gerar:  python -c "import secrets; print(secrets.token_urlsafe(32))"
NUTRISCAN_ADMIN_TOKEN=

# ─── Rate limit (requisições/min por IP) — 0 desliga ────────────────────────
NUTRISCAN_RATE_LIMIT_RPM=120

# ─── Caminhos (opcional — padrão: backend/data/) ───────────────────────────
# NUTRISCAN_DB_PATH=
# NUTRISCAN_IMAGENS_DIR=
